# MirAI Agent Builder — exemple de configuration (mode standalone).
#
# Aucune dépendance externe (pas d'owuicore-main) : Postgres est lancé par
# docker-compose.yml, l'authentification est un stub local (voir
# src/lib/auth.ts) et il n'y a pas d'intégration OpenWebUI.

# =============================================================================
# Obligatoires
# =============================================================================

# --- Image et tag ---
AGENT_BUILDER_IMAGE=miraiku-agents:dev

# --- Ingress / TLS (déploiement K8s uniquement) ---
AGENTS_HOST=myagents.fake-domain.name
AGENTS_TLS_SECRET_NAME=agent-builder-tls

# --- NextAuth ---
# En local, laisser http://localhost:3001.
NEXTAUTH_URL=http://localhost:3001
# openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME

# --- Base de données (créée par le service `postgres` de docker-compose.yml) ---
DATABASE_URL=postgresql://app:app@postgres:5432/agentbuilder?schema=public

# =============================================================================
# Optionnelles
# =============================================================================

# --- Scaleway Generative APIs (LLM) ---
# Si absentes, /api/ab/prompt/assist et /optimize renvoient 501 Not Implemented.
# SCW_LLM_BASE_URL=https://api.scaleway.ai/PROJECT_ID/v1
# SCW_SECRET_KEY_LLM=CHANGE_ME
# SCW_LLM_MODEL=gpt-oss-120b

# --- URL publique d'une instance OpenWebUI externe (optionnel) ---
# Si renseignée, un lien "Continuer dans MirAI Chat" apparaît sur les agents
# publiés. Laisser vide si vous n'utilisez pas OpenWebUI.
# OWUI_PUBLIC_URL=https://mirai.fake-domain.name
