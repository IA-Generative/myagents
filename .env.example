# Configuration de dev locale apps/server + apps/web (copier en .env).
# apps/next a son propre fichier : apps/next/.env.example.
# Lu par :
# - docker compose (interpolation dans docker-compose.yml)
# - le server lancé sans Docker (apps/server/app/core/config.py le localise)
# - le web lancé sans Docker (apps/web/vite.config.ts pointe envDir ici)

# --- Accès via code-server port-forwarding -----------------------------------
# Si tu accèdes aux services via les URLs de port-forwarding de code-server
# (ex. https://5173.code.example.fr), définis le domaine de base.
# Chaque service est exposé sur un sous-domaine <port>.<domain>.
# Laisser vide pour utiliser localhost (accès local direct sur la VM).
CODE_SERVER_DOMAIN=example.invalid

# --- server -----------------------------------------------------------------
# Valeurs pour un lancement hors Docker ; docker-compose.yml impose ses propres
# DATABASE_URL / QDRANT_URL / CORS_ORIGINS sur le réseau des conteneurs.
DATABASE_URL=postgresql+asyncpg://agents:agents@localhost:5432/agents
QDRANT_URL=http://localhost:6333
CORS_ORIGINS=["http://localhost:5173"]

LOG_LEVEL=INFO

# Identité de substitution tant que l'authentification réelle (OIDC) n'est pas branchée.
DEFAULT_USER_ID=demo-user

# URL du server vue par le navigateur : base des liens de téléchargement des présentations
# générées par l'agent (exposé dans Open WebUI). Avec code-server : https://<SERVER_PORT>.<domaine>.
PUBLIC_BASE_URL=http://localhost:8000

# --- SSO Keycloak (realm `myagents`) -----------------------------------------
# OIDC_ENABLED=true active la validation JWT sur le server (Bearer token). Obligatoire en
# production : le server refuse de démarrer avec ENVIRONMENT=production et OIDC_ENABLED=false.
# OIDC_ISSUER doit être exactement le claim `iss` des tokens (URL publique de Keycloak).
# En local avec `make up-sso`, docker-compose le dérive de KEYCLOAK_HOSTNAME et récupère
# les clés JWKS via le réseau compose (OIDC_JWKS_URL).
OIDC_ENABLED=false
OIDC_ISSUER=http://localhost:8180/realms/myagents
# OIDC_JWKS_URL=http://keycloak:8080/realms/myagents/protocol/openid-connect/certs
OIDC_AUDIENCE=myagents-api
# Flux OIDC mené par le server pour le front Vue (BFF) : le navigateur ne reçoit qu'un cookie de
# session HttpOnly. Client confidentiel `myagents-server` du realm ; en production, secret fort.
OIDC_CLIENT_ID=myagents-server
OIDC_CLIENT_SECRET=dev-myagents-server-secret
# Realm joignable depuis le server (compose : http://keycloak:8080/realms/myagents), sinon OIDC_ISSUER.
# OIDC_INTERNAL_URL=http://keycloak:8080/realms/myagents
# Origine du front vue par le navigateur (redirect_uri /api/auth/callback). Vide : déduite de
# CODE_SERVER_DOMAIN et WEB_PORT (https://<WEB_PORT>.<domaine>), sinon http://localhost:<WEB_PORT>.
# Le cookie est Secure dès que l'URL est en https.
# WEB_PUBLIC_URL=http://localhost:5173
# Clé de chiffrement des jetons en base ; vide = repli sur OIDC_CLIENT_SECRET.
# SESSION_SECRET=

# --- Endpoint compatible OpenAI (Scaleway, OpenAI, Ollama...) -----------------
# Dans docker compose, `localhost` désigne le conteneur : utiliser une URL joignable
# depuis le conteneur (ex. http://host.docker.internal:11434/v1). Ne pas pointer vers
# l'OpenWebUI local, qui expose déjà les agents de ce server (boucle).
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
LLM_DEFAULT_MODEL=gpt-oss-120b
LLM_EMBEDDING_MODEL=nomic-embed-text
# LLM-juge de la garde anti-prompt-injection : un juge indisponible (modèle renommé,
# 400...) BLOQUE toutes les réponses (fail-closed). Vide = LLM_ASSIST_MODEL.
# LLM_GUARD_JUDGE_MODEL=

# Clé partagée pour authentifier les appels d'OpenWebUI vers /v1/models et
# /v1/chat/completions. Si défini, la clé est toujours exigée ; vide = /v1 ouvert en dev
# (OIDC_ENABLED=false) et fermé (401) dès que OIDC est activé. `openssl rand -hex 32`.
# Avec `make up-owui`, la même clé est injectée dans OpenWebUI (connexion OpenAI auto).
OPENWEBUI_API_KEY=

# --- OpenWebUI local (profil `owui`, optionnel) ------------------------------
# OPENWEBUI_WEBUI_SECRET_KEY=change-me   # openssl rand -hex 32
# OPENWEBUI_PORT=3000
# OPENWEBUI_IMAGE_TAG=v0.8.12
# OPENWEBUI_OAUTH_CLIENT_SECRET=dev-openwebui-secret  # secret du client `open-webui`

# --- Keycloak local (profils `sso` + `owui`) ---------------------------------
# KEYCLOAK_PORT=8180
# KEYCLOAK_IMAGE_TAG=26.4.0
# KEYCLOAK_ADMIN=admin
# Mots de passe générés par `make ensure-env` (openssl rand -hex 16) : console Keycloak et
# comptes de dev du realm. Aucun mot de passe par défaut.
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DEV_ADMIN_PASSWORD=
KEYCLOAK_DEV_USER_PASSWORD=
# KEYCLOAK_HOSTNAME=http://localhost:8180
# Realm `myagents` importé depuis keycloak/realm-myagents.json :
#   - admin (rôle admin), mot de passe KEYCLOAK_DEV_ADMIN_PASSWORD
#   - user1 (rôle user), mot de passe KEYCLOAK_DEV_USER_PASSWORD
# Clients : myagents-server (FastAPI, flux OIDC du front Vue), miraiku-agents (Next.js), open-webui (OWUI)

# --- web ----------------------------------------------------------------------
# Chemin relatif : le navigateur appelle toujours la même origine ; le serveur
# Vite relaie vers l'API ci-dessous. L'authentification passe par /api/auth (cookie de session).
VITE_API_URL=/api
API_PROXY_TARGET=http://localhost:8000

# --- ports exposés par docker-compose.yml (optionnel) ------------------------
# SERVER_PORT=8000
# WEB_PORT=5173
# POSTGRES_PORT=5432
# QDRANT_PORT=6333
# KEYCLOAK_PORT=8180
