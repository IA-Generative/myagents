# Configuration de dev locale apps/server + apps/web (copier en .env).
# apps/next a son propre fichier : apps/next/.env.example.
#
# Lu par :
# - docker compose (interpolation dans docker-compose.yml)
# - le server lancé sans Docker (apps/server/app/core/config.py le localise)
# - le web lancé sans Docker (apps/web/vite.config.ts pointe envDir ici)

# --- server -----------------------------------------------------------------
# Valeurs pour un lancement hors Docker ; docker-compose.yml impose ses propres
# DATABASE_URL / QDRANT_URL / CORS_ORIGINS sur le réseau des conteneurs.
DATABASE_URL=postgresql+asyncpg://agents:agents@localhost:5432/agents
QDRANT_URL=http://localhost:6333
CORS_ORIGINS=["http://localhost:5173"]

LOG_LEVEL=INFO

# Identité de substitution tant que l'authentification réelle (OIDC) n'est pas branchée.
DEFAULT_USER_ID=demo-user

# --- SSO Keycloak (realm `myagents`) -----------------------------------------
# OIDC_ENABLED=true active la validation JWT sur le server (Bearer token).
# En local avec `make up-sso`, le server joint Keycloak via le réseau compose.
OIDC_ENABLED=false
OIDC_ISSUER=http://localhost:8180/realms/myagents
OIDC_AUDIENCE=myagents-api

# --- Endpoint compatible OpenAI (Scaleway, OpenAI, Ollama...) -----------------
# Dans docker compose, `localhost` désigne le conteneur : utiliser une URL joignable
# depuis le conteneur (ex. http://host.docker.internal:11434/v1). Ne pas pointer vers
# l'OpenWebUI local, qui expose déjà les agents de ce server (boucle).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_DEFAULT_MODEL=gpt-oss-120b
LLM_EMBEDDING_MODEL=nomic-embed-text

# Clé partagée pour authentifier les appels d'OpenWebUI vers /v1/models et
# /v1/chat/completions. Vide = /v1 répond toujours 401. Générer avec `openssl rand -hex 32`.
# Avec `make up-owui`, la même clé est injectée dans OpenWebUI (connexion OpenAI auto).
OPENWEBUI_API_KEY=

# --- OpenWebUI local (profil `owui`, optionnel) ------------------------------
# OPENWEBUI_WEBUI_SECRET_KEY=change-me   # openssl rand -hex 32
# OPENWEBUI_PORT=3000
# OPENWEBUI_IMAGE_TAG=v0.8.12
# OPENWEBUI_OAUTH_CLIENT_SECRET=dev-openwebui-secret  # secret du client `open-webui`

# --- Keycloak local (profils `sso` + `owui`) ---------------------------------
# KEYCLOAK_PORT=8180
# KEYCLOAK_IMAGE_TAG=26.4.0
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin
# KEYCLOAK_HOSTNAME=http://localhost:8180
# Realm `myagents` importé depuis keycloak/realm-myagents.json :
#   - admin/admin (rôle admin)
#   - user1/user1 (rôle user)
# Clients : myagents-web (Vue), miraiku-agents (Next.js), open-webui (OWUI)

# --- web ----------------------------------------------------------------------
# Chemin relatif : le navigateur appelle toujours la même origine ; le serveur
# Vite relaie vers l'API ci-dessous.
VITE_API_URL=/api
API_PROXY_TARGET=http://localhost:8000
# SSO Keycloak pour apps/web (client public `myagents-web`, PKCE)
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=myagents
VITE_KEYCLOAK_CLIENT_ID=myagents-web

# --- ports exposés par docker-compose.yml (optionnel) ------------------------
# SERVER_PORT=8000
# WEB_PORT=5173
# POSTGRES_PORT=5432
# QDRANT_PORT=6333
# KEYCLOAK_PORT=8180
