# Configuration de dev locale apps/server + apps/web (copier en .env).
# apps/next a son propre fichier : apps/next/.env.example.
#
# Lu par :
# - docker compose (interpolation dans docker-compose.yml)
# - le server lancé sans Docker (apps/server/app/core/config.py le localise)
# - le web lancé sans Docker (apps/web/vite.config.ts pointe envDir ici)

# --- server -----------------------------------------------------------------
# Valeurs pour un lancement hors Docker ; docker-compose.yml impose ses propres
# DATABASE_URL / QDRANT_URL / CORS_ORIGINS sur le réseau des conteneurs.
DATABASE_URL=postgresql+asyncpg://agents:agents@localhost:5432/agents
QDRANT_URL=http://localhost:6333
CORS_ORIGINS=["http://localhost:5173"]

LOG_LEVEL=INFO

# Identité de substitution tant que l'authentification réelle (OIDC) n'est pas branchée.
DEFAULT_USER_ID=demo-user

# Endpoint compatible OpenAI (OpenWebUI, Scaleway, OpenAI, Ollama...).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_DEFAULT_MODEL=gpt-oss-120b
LLM_EMBEDDING_MODEL=nomic-embed-text

# Clé partagée pour authentifier les appels entrants d'une instance OpenWebUI
# vers /v1/models et /v1/chat/completions (Settings > Admin > Connections > OpenAI
# côté OpenWebUI). Vide = intégration désactivée. Générer avec `openssl rand -hex 32`.
OPENWEBUI_API_KEY=

# --- web ----------------------------------------------------------------------
# Chemin relatif : le navigateur appelle toujours la même origine ; le serveur
# Vite relaie vers l'API ci-dessous.
VITE_API_URL=/api
API_PROXY_TARGET=http://localhost:8000

# --- ports exposés par docker-compose.yml (optionnel) ------------------------
# SERVER_PORT=8000
# WEB_PORT=5173
# POSTGRES_PORT=5432
# QDRANT_PORT=6333
