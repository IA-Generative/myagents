# MirAI Agent Builder (apps/next) — exemple de configuration (mode standalone).
#
# Copier en apps/next/.env. Lu par apps/next/docker-compose.yml et par les
# scripts apps/next/deploy/*.sh. Postgres est lancé par docker-compose.yml,
# l'authentification est un stub local (voir src/lib/auth.ts).

# =============================================================================
# Obligatoires
# =============================================================================

# --- Image et tag ---
AGENT_BUILDER_IMAGE=miraiku-agents:dev

# --- Ingress / TLS (déploiement K8s uniquement) ---
AGENTS_HOST=myagents.fake-domain.name
AGENTS_TLS_SECRET_NAME=agent-builder-tls

# --- NextAuth ---
# En local, laisser http://localhost:3001.
NEXTAUTH_URL=http://localhost:3001
# openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME

# --- Base de données (créée par le service `postgres` de docker-compose.yml) ---
DATABASE_URL=postgresql://app:app@postgres:5432/agentbuilder?schema=public

# =============================================================================
# Optionnelles
# =============================================================================

# --- Scaleway Generative APIs (LLM) ---
# Si absentes, /api/ab/prompt/assist et /optimize renvoient 501 Not Implemented.
# SCW_LLM_BASE_URL=https://api.scaleway.ai/PROJECT_ID/v1
# SCW_SECRET_KEY_LLM=CHANGE_ME
# Modèle LLM par défaut (source de vérité unique, partagée avec apps/server).
# SCW_LLM_MODEL est conservé pour rétro-compat mais LLM_DEFAULT_MODEL prime.
# LLM_DEFAULT_MODEL=gpt-oss-120b
# SCW_LLM_MODEL=gpt-oss-120b

# --- OpenWebUI (optionnel) ---
# Instance locale : `make up-owui` à la racine (voir README, section OpenWebUI local).
# URL interne (réseau docker `myagents-shared`) pour les appels API admin.
# OWUI_BASE_URL=http://openwebui:8080
# Clé API d'un compte admin OpenWebUI (Paramètres > Compte > Clés API).
# Sans elle, la synchro des modèles vers OpenWebUI est ignorée.
# OWUI_ADMIN_API_KEY=sk-CHANGE_ME
# URL publique (navigateur) : lien "Continuer dans MirAI Chat" sur les agents publiés.
# OWUI_PUBLIC_URL=http://localhost:3000

# --- SSO Keycloak (realm `myagents`) ---
# Démarré par `make up-sso` à la racine. Le client `miraiku-agents` est déclaré
# dans keycloak/realm-myagents.json (secret `dev-miraiku-agents-secret` en local).
# KEYCLOAK_ISSUER=http://keycloak:8080/realms/myagents
# KEYCLOAK_CLIENT_ID=miraiku-agents
# KEYCLOAK_CLIENT_SECRET=dev-miraiku-agents-secret
# Restriction d'accès à un groupe du realm (claim `groups`). Vide = pas de restriction.
# OIDC_GROUPE_EXIGE=myagents-admin
