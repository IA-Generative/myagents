{
  "name": "miraiku-agents",
  "version": "0.1.0",
  "private": true,
  "description": "MirAI Agent Builder — interface de création d'agents IA pour le Ministère de l'Intérieur",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:redteam": "vitest run tests/redteam",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@codegouvfr/react-dsfr": "^1.14.0",
    "@prisma/client": "^5.18.0",
    "@tanstack/react-query": "^5.51.0",
    "next": "15.5.19",
    "next-auth": "^4.24.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tss-react": "^4.9.12",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.3",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.19",
    "postcss": "^8.5.15",
    "prisma": "^5.18.0",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vitest": "^3.2.6"
  }
}
